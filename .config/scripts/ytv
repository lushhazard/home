#!/usr/bin/env bash

if [ -z "$1" ]; then
    echo "Usage: $0 <YouTube URL>"
    exit 1
fi

URL="$1"
OUTDIR="$HOME/Videos/ytv"
mkdir -p "$OUTDIR"

yt-dlp -f "bv*+ba" --merge-output-format mkv "$URL" \
  -o "$OUTDIR/%(title)s.%(ext)s" \
  --exec '
    input={}
    sleep 1

    if [ ! -f "$input" ]; then
      echo "ERROR: File not found: $input"
      exit 1
    fi

    dir=$(dirname "$input")
    base=$(basename "$input" .mkv)
    output="${dir}/${base}_hevc_resolve.mkv"

    echo ">> Transcoding: $input"
    echo ">> Output will be: $output"

    ffmpeg -y -i "$input" \
      -c:v libx265 -crf 23 -preset medium -pix_fmt yuv420p \
      -c:a pcm_s24le "$output"
  '

